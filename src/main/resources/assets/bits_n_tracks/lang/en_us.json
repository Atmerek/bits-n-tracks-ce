    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour2": "Toggles whether the cogwheel model is _shown_ or _hidden_.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition3": "Shift + Right-click a cogwheel",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour3": "Resets alignment, track routing and _suspension settings_ on the whole track, and makes the cogwheels _visible_ again.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition4": "Right-click a run of track",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour4": "_Tightens_ the belt, so it holds its line and molds to blocks less.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition5": "Shift + Right-click a run of track",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour5": "_Slackens_ it instead, letting it sag and follow the ground.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.control1": "Left-click",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.action1": "Toggles _suspension physics_ for the cogwheel.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.control2": "Shift + Left-click a cogwheel face",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.action2": "Brings the _far run_ of track all the way around the cogwheel, so clicking its top wraps the _bottom_ track over it and makes it turn _the other way_. The center returns it to _automatic_.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.control3": "Ctrl + Left-click",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.action3": "Switches between moving _one cogwheel_ and moving every cogwheel on the track that shares its _suspension physics_ setting.",
    "item.bits_n_tracks.suspension_piece": "Suspension Piece",
    "item.bits_n_tracks.suspension_piece.tooltip.summary": "Gives a _physics-enabled tiny, small or medium cogwheel_ a swinging arm, so it rides its suspension along an _arc_ around a pivot.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition1": "Right-click a physics-enabled tiny, small or medium cogwheel",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour1": "_Selects_ it. Right-click its centre again to deselect. Without a piece, a physics cogwheel is a _rigid_ wheel.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition2": "Then look beside it and right-click",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour2": "Mounts a swinging _arm_, shown in _green_ where it fits: it pivots on the cogwheel's _top corner_, which needs a _solid block_ touching it along the axle.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition3": "Or right-click the small or tiny cogwheel next to it",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour3": "Mounts a _bogie_ across both, using _two_ pieces. It hangs from a _solid block_ right above either cogwheel, or from one next to that spot along the axle. Blocks can sit on top of it.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition4": "Shift + Right-click the cogwheel with an empty hand",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour4": "Takes the piece or bogie back off.",
