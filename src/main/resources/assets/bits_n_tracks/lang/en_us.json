    "item.bits_n_tracks.cog_alignment_lever": "Cog Alignment Lever",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.summary": "Fine-tunes _flanged cogwheels_ and their tracks. Its panel shows the current _mode_ and what it does.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition1": "Hold Alt and scroll",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour1": "Switches between _Offset_, _Route_, _Tension_, _Visibility_, _Physics_ and _Reset_.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition2": "Offset",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour2": "Right-click a cogwheel to select it, then scroll to move it _one pixel_ at a time. Shift + scroll picks the axis.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition3": "Route",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour3": "Right-click a cogwheel face to bring the _far run_ of track around it, so clicking its top wraps the _bottom_ track over it and makes it turn _the other way_. The centre returns it to _automatic_.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition4": "Tension",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour4": "Right-click a track to select it, then scroll to _tighten_ it, so it holds its line, or _slacken_ it, so it sags and follows the ground.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition5": "Visibility",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour5": "Right-click a cogwheel to _show_ or _hide_ its model.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition6": "Physics",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour6": "Right-click a cogwheel to switch its _suspension physics_ on or off.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition7": "Reset",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.behaviour7": "Right-click a cogwheel twice to reset alignment, track routing, _suspension settings_ and visibility on its whole track.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.control1": "Ctrl + Left-click",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.action1": "Switches Offset between moving _one cogwheel_ and moving every cogwheel on the track that shares its _suspension physics_ setting.",
    "item.bits_n_tracks.suspension_piece": "Suspension Piece",
    "item.bits_n_tracks.suspension_piece.tooltip.summary": "Gives a _physics-enabled flanged cogwheel_ of any size a swinging arm, so it rides its suspension along an _arc_ around a pivot.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition1": "Right-click a physics-enabled flanged cogwheel of any size, 2-wide ones included",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour1": "_Selects_ it. Right-click its centre again to deselect. Without a piece, a physics cogwheel is a _rigid_ wheel.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition2": "Then look beside it and right-click",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour2": "Mounts a swinging _arm_, shown in _green_ where it fits: it pivots on the cogwheel's _top corner_, which needs a _block_ touching it along the axle.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition3": "Or right-click the small, intermediate or tiny cogwheel next to it",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour3": "Mounts a _bogie_ across both, using _two_ pieces. It hangs from a _block_ right above either cogwheel, or from one next to that spot along the axle. Blocks can sit on top of it.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition4": "Or right-click a 2-wide small, intermediate or tiny cogwheel, then the 2-wide one next to it",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour4": "Mounts a _wide bogie_ between both pairs, using _two_ pieces. Each pair turns into _two separate wheels_ with the bogie between them. It hangs from a _block_ right above either pair, or from one past the end of the pairs along the axle.",
    "item.bits_n_tracks.suspension_piece.tooltip.condition5": "Shift + Right-click the cogwheel with an empty hand",
    "item.bits_n_tracks.suspension_piece.tooltip.behaviour5": "Takes the piece or bogie back off.",
    "item.bits_n_tracks.suspension_tool": "Suspension Tool",
    "item.bits_n_tracks.suspension_tool.tooltip.summary": "Reads and tunes the suspension of cogwheels carrying a _Suspension Piece_. Offers _11 settings_ of customizability. Default is _4_. Any other cogwheel reads _0_.",
    "item.bits_n_tracks.suspension_tool.tooltip.condition1": "Looking at a cogwheel with a Suspension Piece",
    "item.bits_n_tracks.suspension_tool.tooltip.behaviour1": "Its panel and dial read that cogwheel's settings.",
