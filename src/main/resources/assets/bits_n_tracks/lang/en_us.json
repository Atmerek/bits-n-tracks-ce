    "item.bits_n_tracks.cog_alignment_lever": "Cog Alignment Lever",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.summary": "Fine-tunes _flanged cogwheel_ alignment and suspension physics.",
    "item.bits_n_tracks.cog_alignment_lever.tooltip.condition1": "Right-click a cogwheel face",
